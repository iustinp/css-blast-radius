{
  "name": "@css-blast-radius/backend",
  "version": "0.1.0",
  "description": "Local daemon for CSS Blast Radius: captures every page in Chromium once, then answers how many pages a CSS edit reaches as you type (L0/L1), with on-demand render (L2) and live (L3) checks over a JSON-RPC socket.",
  "type": "module",
  "bin": {
    "css-blast-radius-daemon": "./dist/cli.js"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "vitest run",
    "bench": "tsx bench/bench.mts",
    "dev:daemon": "tsx src/cli.ts",
    "smoke": "tsx scripts/smoke.mts"
  },
  "dependencies": {
    "better-sqlite3": "^11.3.0",
    "chokidar": "^3.6.0",
    "css-select": "^7.0.0",
    "diff": "^9.0.0",
    "fast-glob": "^3.3.2",
    "playwright-core": "^1.63.0",
    "postcss": "^8.4.47",
    "postcss-selector-parser": "^6.1.2"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.11",
    "@types/node": "^22.7.5",
    "tsx": "^4.19.1",
    "typescript": "^5.6.2",
    "vitest": "^2.1.2"
  }
}
